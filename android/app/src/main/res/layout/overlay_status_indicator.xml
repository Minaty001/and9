<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="8dp">

    <!-- Status Orb -->
    <com.jarvis.assistant.overlay.StatusOrb
        android:id="@+id/statusOrb"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp" />

    <!-- Pipeline Stage Text -->
    <TextView
        android:id="@+id/pipelineStageText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Idle"
        android:textColor="#88FFFFFF"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:textAllCaps="true"
        android:layout_marginBottom="8dp" />

    <!-- Status bar with memory status and skill count -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="4dp">

        <!-- Memory connection dot -->
        <View
            android:id="@+id/memoryStatusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@android:color/holo_green_dark"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/memoryStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Memory Sync"
            android:textColor="#88FFFFFF"
            android:textSize="11sp"
            android:layout_marginEnd="16dp" />

        <!-- Skill badge icon -->
        <TextView
            android:id="@+id/skillCountBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ 24 Skills"
            android:textColor="#3498DB"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

    <!-- Goal Ticker (scrolling text) -->
    <TextView
        android:id="@+id/activeGoalTicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎯 Active Goal: AI Operating System Upgrade"
        android:textColor="#55FFFFFF"
        android:textSize="10sp"
        android:ellipsize="marquee"
        android:singleLine="true"
        android:marqueeRepeatLimit="marquee_forever"
        android:scrollHorizontally="true"
        android:focusable="true"
        android:focusableInTouchMode="true" />

</LinearLayout>
