# JARVIS v4 — Environment Configuration
# Copy this to .env and fill in your keys.

# Required
GROQ_API_KEY=gsk_your_key_here

# Optional — leave empty to disable features
SERP_API_KEY=
NEWS_API_KEY=
WEATHER_API_KEY=

# Flask
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=generate-a-random-secret-key

# Render
RENDER=True
