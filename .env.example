# JARVIS v4 — Environment Configuration
# Copy this to .env and fill in your keys.

# Required
GROQ_API_KEY=gsk_your_key_here

# MongoDB (optional — leave empty to skip durable chat logging)
MONGO_URI=mongodb+srv://user:password@cluster0.jvqzf7k.mongodb.net/?appName=Cluster0

# Optional — leave empty to disable features
SERP_API_KEY=
NEWS_API_KEY=
WEATHER_API_KEY=

# Flask
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=generate-a-random-secret-key

# Render
RENDER=True
